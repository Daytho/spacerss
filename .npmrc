# Do not run dependency lifecycle scripts during install.
#
# Two reasons:
#   1. Security. npm install scripts execute arbitrary code from every package
#      in the tree; disabling them removes the most common supply-chain attack
#      path during setup.
#   2. Portability. npm auto-runs `node-gyp rebuild` on any package containing
#      a binding.gyp, so better-sqlite3 tries to compile from source and fails
#      on machines without a C++ toolchain. It already ships prebuilt binaries
#      for macOS, Windows and Linux, which load fine without the build step.
ignore-scripts=true
